# Copy to the shell or a gitignored env file before running the API against KBill.
# The token is not given a default in application.yml and must not be committed.

BILLING_PROVIDER=dummy
KBILL_BASE_URL=https://development.kbillpay.com/api/kbill/v3/customer/bbps
KBILL_API_TOKEN=
KBILL_USER_AGENT=paytrix-b2bfintech/1.0
KBILL_LOG_PAYLOADS=false

# KBill rejects calls whose source IP is not registered on the partner account.
# This machine is already whitelisted for UAT. A deployed environment needs its egress IP registered.
