# Template only. Copy to .env (gitignored) for local use or configure as environment variables in production.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:25060/defaultdb?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Required (>= 32 bytes random secret for HS256 JWT signing).
JWT_SECRET=

# First platform superadmin, created at startup only when none exists.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_NAME="Paytrix Admin"
PLATFORM_ADMIN_PASSWORD=

# Public site origin. No trailing slash. Comma-separate extras such as www.
CORS_ALLOWED_ORIGINS=https://paytrix.in

BILLING_PROVIDER=branchx
BRANCHX_BASE_URL=https://10x.api.branchx.in
BRANCHX_API_TOKEN=
BILLING_AUTO_FETCH_ENABLED=false

SPACES_ENDPOINT=https://paytrix.sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=paytrix
SPACES_PREFIX=client
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

LOGGING_LEVEL_COM_B2BFINTECH=INFO
