# Template only. The paste-ready production file is .env (gitignored).
# DigitalOcean App Platform does not read this file. Paste .env into the app's
# environment variables. Leave secrets out of git.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:25060/defaultdb?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Empty disables the shared dev password. Do not set this to Password@123 in production.
AUTH_DEMO_PASSWORD=

# Empty falls back to the dev code 123456. Set a long random value in production.
OTP_DUMMY_CODE=

JWT_SECRET=

# First platform admin, created at startup when none exists.
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_PASSWORD=

# Public site origin. No trailing slash. Comma-separate extras such as www.
CORS_ALLOWED_ORIGINS=https://paytrix.in

BILLING_PROVIDER=kbill
KBILL_BASE_URL=https://kbillpay.com/api/kbill/v3/customer/bbps
KBILL_API_TOKEN=
KBILL_USER_AGENT=paytrix-b2bfintech/1.0
KBILL_LOG_PAYLOADS=false

SPACES_ENDPOINT=https://paytrix.sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=paytrix
SPACES_PREFIX=client
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

LOGGING_LEVEL_COM_B2BFINTECH=INFO
