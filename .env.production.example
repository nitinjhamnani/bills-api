# ==============================================================================
# Paytrix Backend API (bills-api) — Production Environment Configuration
# Copy to `.env` on your server or paste into DigitalOcean App Platform (RUN_TIME)
# ==============================================================================

# --- Spring Profile & HTTP Server ---
SPRING_PROFILES_ACTIVE=prod
# DigitalOcean App Platform injects PORT=8080 automatically; override only on VM/Docker
PORT=8080

# --- PostgreSQL Database (Managed DB / SSL required in production) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME_DB_HOST:25060/paytrix_prod?sslmode=require
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=15

# --- JWT & Server-Side Session Security ---
# REQUIRED: Generate a >= 32-byte secret with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_BYTE_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_TIMEOUT_HOURS=12

# --- Initial Super Admin Bootstrap ---
# Seeded at startup ONLY when no SUPER_ADMIN exists in `users`.
# Also used as confirmation password for Super Admin permanent corporate deletion.
PLATFORM_ADMIN_EMAIL=admin@paytrix.in
PLATFORM_ADMIN_PHONE=9000000000
PLATFORM_ADMIN_NAME="Paytrix Super Admin"
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Allowed Frontend Origins (CORS) ---
# Exact scheme + host, comma-separated, NO trailing slash.
CORS_ALLOWED_ORIGINS=https://paytrix.in,https://www.paytrix.in

# --- BBPS / 10X FI (BranchX) Provider ---
BILLING_PROVIDER=branchx
BRANCHX_BASE_URL=https://10x.api.branchx.in
BRANCHX_API_TOKEN=CHANGE_ME_BRANCHX_API_TOKEN
BRANCHX_CONNECT_TIMEOUT_MS=5000
BRANCHX_READ_TIMEOUT_MS=25000
BILLING_CATALOG_REFRESH_MS=7200000
BILLING_PARAMETER_CACHE_TTL_MS=7200000
BILLING_AUTO_FETCH_ENABLED=true
BILLING_WORKER_POLL_MS=5000
APP_BILLING_SLA_THRESHOLD_MINUTES=1440

# --- DigitalOcean Spaces (S3-Compatible Document & Proof Storage) ---
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=paytrix
SPACES_PREFIX=prod/client
SPACES_ACCESS_KEY=CHANGE_ME_SPACES_ACCESS_KEY
SPACES_SECRET_KEY=CHANGE_ME_SPACES_SECRET_KEY

# --- Logging & JVM ---
LOGGING_LEVEL_COM_B2BFINTECH=INFO
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
